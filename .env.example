PAYSTACK_SECRET_KEY=sk_live_replace_with_your_key
VITE_PAYSTACK_PUBLIC_KEY=pk_live_replace_with_your_key
# Use your Stripe test-mode secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
PORT=4242
APP_URL=http://127.0.0.1:5173

# Supabase (server-side only; never expose these to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret

# Optional: enables live answers from the Design Enthusiast.
# Without a key, the site uses its built-in catalog guide instead.
OPENAI_API_KEY=sk-proj-replace-with-your-key
OPENAI_MODEL=gpt-4.1-mini

# Private, loopback-only admin console. Use a unique passphrase of at least 16 characters.
ADMIN_PASSWORD=replace-with-a-long-unique-passphrase
# Optional; a random session signing secret is generated each time the admin server starts.
ADMIN_SESSION_SECRET=

# Server-only CJdropshipping credentials. Never place these in frontend code.
# Use the official CJ API documentation to confirm which of these fields your account requires.
CJ_API_BASE_URL=https://your-cj-api-base-url
CJ_ACCESS_TOKEN=replace-with-cj-access-token-if-required
CJ_API_KEY=replace-with-cj-api-key-if-required
CJ_API_SECRET=replace-with-cj-api-secret-if-required
